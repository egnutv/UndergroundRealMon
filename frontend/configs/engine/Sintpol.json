    ".yes": [
        {   
            "cssVar": "width: $size$%;",
            "source": "window.innerWidth",
            "points": [
                ["100", "100"],
                ["1000", "70"],
                ["1500", "50"]
            ]
        }
    ],
    ".dymBG": [
        {   
            "cssVar": "transform: scale($size$);",
